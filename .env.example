# DuaVero Environment Configuration Template (Copy to .env for local development)

# Application Environment
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database Configuration (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=duavero_dev
DB_USERNAME=duavero_user
DB_PASSWORD=duavero_secure_pass

# Redis Configuration (L2 Cache, Rate Limits & ShedLock)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Cryptography
# JWT Signing Secret (Minimum 256-bit / 32 characters)
DUAVERO_JWT_SECRET=duavero-super-secure-production-ready-jwt-secret-key-32chars-min
DUAVERO_JWT_EXPIRATION_MINUTES=15
DUAVERO_JWT_REFRESH_EXPIRATION_DAYS=7

# AES-256 Master Key for Gateway Credentials at Rest (32 ASCII characters or 64 hex characters)
DUAVERO_ENCRYPTION_KEY=duavero-aes-256-gcm-master-encryption-key-32b
